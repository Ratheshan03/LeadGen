# =============================================================================
#  LeadGen settings - copy this file to ".env" (same folder) and fill it in.
# =============================================================================

# --- Google Places API (required) --------------------------------------------
# Create a key in Google Cloud Console with "Places API (New)" enabled and
# billing turned on. Several keys can be listed, separated by commas; LeadGen
# switches key automatically when one is rate limited.
GOOGLE_API_KEYS=

# Hard monthly limit on Google requests (resets on the 1st of each month).
# Crawls stop cleanly when it is reached; run them again to continue.
API_REQUEST_CAP=10000

# Only used for cost estimates (USD per 1,000 requests).
COST_PER_1000_REQUESTS_USD=35

# --- Storage -------------------------------------------------------------------
# "sqlite" (default): leads are kept in storage/leadgen.db on this computer.
# "mongodb": use your own MongoDB server or Atlas cluster instead.
STORAGE=sqlite
# MONGO_DB_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/?retryWrites=true&w=majority
# MONGO_DB_NAME=leadgen

# --- Backend -------------------------------------------------------------------
# Where custom_crawl.py, full_crawl.py and the dashboard find the backend.
BACKEND_API_URL=http://127.0.0.1:8000
BACKEND_PORT=8000

# Optional: save Excel files and maps somewhere other than the "output" folder.
# OUTPUT_DIR=D:\Leads

# --- Rebuilding New Zealand boundary data (optional) ------------------------------
# Free key from https://datafinder.stats.govt.nz (only needed to re-download data).
# STATS_NZ_API_KEY=
